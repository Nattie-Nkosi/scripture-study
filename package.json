{
  "name": "gospel-library-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm -w web run dev",
    "dev:admin": "npm -w admin run dev",
    "build:web": "npm -w web run build",
    "build:admin": "npm -w admin run build",
    "start:web": "npm -w web run start",
    "start:admin": "npm -w admin run start",
    "lint": "npm -w web run lint && npm -w admin run lint",
    "db:migrate": "npm -w web run db:migrate",
    "db:embed": "npm -w web run db:embed"
  }
}
